{
  "_meta": {
    "purpose": "Reproduce joove k-epsilon channel benchmark",
    "notes": "Pressure-driven periodic channel — P_inlet/P_outlet Dirichlet, periodic V/k/eps"
  },
  "geometry": {
    "type": "channel",
    "Lx": 2.0,
    "Ly": 2.0,
    "Nx": 20,
    "Ny": 20,
    "mesh_type": "triangle",
    "y_first": 0,
    "growth_rate": 1.0,
    "stretching": "geometric",
    "y_first_tol_rel": 0.5,
    "use_symmetry": false
  },
  "nondim": {
    "Re_tau": 550,
    "use_body_force": false,
    "U_inlet": 20.0,
    "k_inlet": 1.5,
    "epsilon_inlet": 2.23,
    "P_inlet": 2.0,
    "P_outlet": 0.0
  },
  "turb": {
    "model": "kepsilon",
    "beta_star": 0.09,
    "C_mu": 0.09,
    "sigma_k_kepsilon": 1.0,
    "sigma_epsilon": 1.3,
    "C_epsilon_1": 1.44,
    "C_epsilon_2": 1.92,
    "nu_t_max_factor": 5000.0,
    "omega_min": 1e-6,
    "k_min": 1e-10,
    "k_max": 100.0,
    "C_lim": 0.0,
    "epsilon_min": 1e-16,
    "epsilon_max": 1e8,
    "f_nu_min": 0.01116225
  },
  "solve": {
    "dt": 0.001,
    "dt_max": 0.01,
    "dt_growth": 1.05,
    "dt_growth_threshold": 0.8,
    "cfl_target": 1.0,
    "t_final": 10000.0,
    "max_iter": 50,
    "steady_tol": 1e-6,
    "enable_physical_convergence": false,
    "picard_max": 4,
    "picard_tol": 1e-4,
    "under_relax_k_omega": 0.5,
    "under_relax_nu_t": 0.3,
    "log_interval": 5,
    "snapshot_interval": 0,
    "out_dir": "results",
    "min_iter": 10,
    "min_dt_ratio": 0.0
  }
}
